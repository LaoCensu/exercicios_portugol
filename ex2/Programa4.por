programa {
  funcao inicio() {
    inteiro num1
    inteiro num2
    inteiro num3
    inteiro num4
    escreva("Escolha a primeira nota: ")
    leia(num1)
    escreva("Escolha segunda nota: ")
    leia(num2)
    escreva("Escolha a terceira nota: ")
    leia(num3)
    escreva("Escolha a quarta nota: ")
    leia(num4)
    escreva("A média do aluno é:\n")
    escreva((num1+num2+num3+num4)/4)
  }
}
